# Port the HTTP + WebSocket server listens on. Hosts (Render/Fly) inject PORT.
PORT=3001

# Comma-separated list of allowed browser origins for CORS + Socket.io.
# In production set this to your deployed frontend URL(s), e.g.
#   CLIENT_ORIGIN=https://party-hub.vercel.app
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# How long (ms) a disconnected player keeps their seat before it's freed.
SEAT_GRACE_MS=45000

# Idle rooms with no activity older than this (ms) are swept. Default 2h.
ROOM_TTL_MS=7200000

# How often (ms) the idle-room cleanup sweep runs. Default 5m.
CLEANUP_INTERVAL_MS=300000

# Rate limits (per player).
MAX_GUESSES_PER_SEC=4
MAX_ROOM_CREATES_PER_MIN=15
MAX_JOINS_PER_MIN=30
