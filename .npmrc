auto-install-peers=true
strict-peer-dependencies=false

# pnpm 11 hard-errors when a dependency's build script is ignored, and every
# `pnpm run` re-verifies deps first (an implicit install) which re-triggers it.
# esbuild (pulled by vite + tsx) hits this on CI. Turning off the pre-run
# verification lets `pnpm --filter … run build` execute without re-checking;
# the install step passes --config.strict-dep-builds=false to clear the gate
# there. Safe: esbuild ships its native binary via platform optional-deps
# (lockfile-pinned), so the skipped postinstall is a no-op.
verify-deps-before-run=false
