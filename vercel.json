{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @party-hub/shared run build && pnpm --filter @party-hub/frontend run build",
  "installCommand": "pnpm install --frozen-lockfile --config.strict-dep-builds=false",
  "outputDirectory": "packages/frontend/dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
